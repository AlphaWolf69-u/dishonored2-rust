struct SssBlurParameters {
    // resolutionScale.xy / globalViewInfos.xy (tan of the half field of view).
    kernel_scale: vec2<f32>,
    // positionToViewTexture.zw: one over the target size.
    texel: vec2<f32>,
    // SSS/BlurQuality.
    quality: vec4<u32>,
}
@group(0) @binding(0) var sss_buffer: texture_2d<f32>;
@group(0) @binding(1) var sss_surface: texture_2d<f32>;
@group(0) @binding(2) var point_clamp: sampler;
@group(0) @binding(3) var bilinear_clamp: sampler;
@group(0) @binding(4) var<uniform> parameters: SssBlurParameters;

@vertex fn vertex(@builtin(vertex_index) index: u32) -> @builtin(position) vec4<f32> {
    let uv = vec2(f32((index << 1u) & 2u), f32(index & 2u));
    return vec4(uv * vec2(2.0, -2.0) + vec2(-1.0, 1.0), 0.0, 1.0);
}

@fragment fn blur(@builtin(position) position: vec4<f32>) -> @location(0) vec4<f32> {
    let surface = textureLoad(sss_surface, vec2<i32>(position.xy), 0);
    if surface.a < 0.0 { discard; }
    // screenPosToTexcoord( sv_position.xy + subpixelOffset.xy, positionToViewTexture ).
    let uv = position.xy * parameters.texel;
    let width = surface.a * parameters.kernel_scale;
    var diffuse = vec3(0.0);
    var weight = vec3(0.0);
    switch parameters.quality.x {
        case 0u: {
            for (var i = 0; i < 92; i++) {
                let w = SKIN_PROFILE_WEIGHTS[i];
                diffuse += textureSampleLevel(sss_buffer, point_clamp, uv + SKIN_PROFILE_SAMPLES_92[i] * width, 0.0).rgb * w;
                weight += w;
            }
        }
        case 1u: {
            for (var i = 0; i < 46; i++) {
                let w = SKIN_PROFILE_WEIGHTS[i];
                diffuse += textureSampleLevel(sss_buffer, bilinear_clamp, uv + SKIN_PROFILE_SAMPLES_46[i] * width, 0.0).rgb * w;
                weight += w;
            }
        }
        case 2u: {
            for (var i = 0; i < 23; i++) {
                let w = SKIN_PROFILE_WEIGHTS[i];
                diffuse += textureSampleLevel(sss_buffer, bilinear_clamp, uv + SKIN_PROFILE_SAMPLES_23[i] * width, 0.0).rgb * w;
                weight += w;
            }
        }
        default: {
            for (var i = 0; i < 16; i++) {
                let w = SKIN_PROFILE_WEIGHTS[i];
                diffuse += textureSampleLevel(sss_buffer, bilinear_clamp, uv + SKIN_PROFILE_SAMPLES_16[i] * width, 0.0).rgb * w;
                weight += w;
            }
        }
    }
    // RangeExpandColorFromR11G11B10 inverts the main pass's linear range
    // compression; both targets already share this pass's units.
    return vec4(diffuse / weight * surface.rgb, 0.0);
}
