// Active ocean noise dependencies from noise.decl. Textures are generated by
// 1402f6450: RGBA8 UNORM permutation and RGBA8 SNORM gradients, point-wrap sampled.
fn noise_curve_three(t: f32) -> f32 {
    return t * t * (3.0 - 2.0 * t);
}
fn noise_curve_five(t: f32) -> f32 {
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}
fn noise_curve(t: f32, quality: i32) -> f32 {
    switch quality {
        case 0: { return t; }
        case 1: { return noise_curve_three(t); }
        case 2: { return noise_curve_five(t); }
        default: { return 0.0; }
    }
}

fn noise_hash_two(p: vec2<f32>) -> vec2<f32> {
    let h = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
    return fract(sin(h) * 43758.5453123);
}

// F1F2Voronoi2D: squared nearest and second-nearest distances plus cell ID.
fn noise_voronoi_two(p: vec2<f32>, chaos: f32) -> vec3<f32> {
    let n = floor(p);
    let f = fract(p);
    var m = vec4(8.0);
    for (var j = -1; j <= 1; j += 1) {
        for (var i = -1; i <= 1; i += 1) {
            let g = vec2(f32(i), f32(j));
            let o = noise_hash_two(n + g);
            let r = g - f + o * chaos;
            let d = dot(r, r);
            if d < m.x {
                m = vec4(d, m.x, o);
            } else if d < m.y {
                m.y = d;
            }
        }
    }
    return vec3(m.xy, dot(m.zw, vec2(1.0, 57.0)));
}

fn noise_shore_voronoi(position: vec2<f32>) -> vec2<f32> {
    let v = noise_voronoi_two(position, 0.7);
    let border = smoothstep(0.05, 0.5, v.y - v.x);
    let id = fract(sin(v.z) * 54651.74916);
    return vec2(id, border);
}

fn noise_gradient_lookup(gradients: texture_2d<f32>, point_wrap: sampler,
                         x: f32, offset: vec3<f32>) -> f32 {
    // The installed 1D gradient table is a 256x1 Texture2D. HLSL broadcasts
    // the scalar coordinate to both texture axes; point wrap selects row zero.
    return dot(textureSampleLevel(gradients, point_wrap, vec2(x), 0.0).rgb, offset);
}

fn noise_gradient_three(permutation: texture_2d<f32>, gradients: texture_2d<f32>,
                        point_wrap: sampler, position: vec3<f32>, quality: i32) -> f32 {
    let lattice = floor(position);
    let p = position - lattice;
    // WGSL remainder, like HLSL fmod, uses truncation rather than floor.
    let grid = (lattice % vec3(256.0)) / 256.0;
    let f = vec3(noise_curve(p.x, quality), noise_curve(p.y, quality), noise_curve(p.z, quality));
    let corners = textureSampleLevel(permutation, point_wrap, grid.xy, 0.0) + vec4(grid.z);
    let one = 1.0 / 256.0;
    return mix(
        mix(mix(noise_gradient_lookup(gradients, point_wrap, corners.x, p),
                noise_gradient_lookup(gradients, point_wrap, corners.z, p + vec3(-1.0, 0.0, 0.0)), f.x),
            mix(noise_gradient_lookup(gradients, point_wrap, corners.y, p + vec3(0.0, -1.0, 0.0)),
                noise_gradient_lookup(gradients, point_wrap, corners.w, p + vec3(-1.0, -1.0, 0.0)), f.x), f.y),
        mix(mix(noise_gradient_lookup(gradients, point_wrap, corners.x + one, p + vec3(0.0, 0.0, -1.0)),
                noise_gradient_lookup(gradients, point_wrap, corners.z + one, p + vec3(-1.0, 0.0, -1.0)), f.x),
            mix(noise_gradient_lookup(gradients, point_wrap, corners.y + one, p + vec3(0.0, -1.0, -1.0)),
                noise_gradient_lookup(gradients, point_wrap, corners.w + one, p + vec3(-1.0, -1.0, -1.0)), f.x), f.y), f.z);
}

// FractalNoise3DBlendLastOctave with the active GPU-Gems hash method. The full
// last amplitude remains in the normalization even for a zero last multiplier.
fn noise_fractal_three(permutation: texture_2d<f32>, gradients: texture_2d<f32>,
                       point_wrap: sampler, position: vec3<f32>, octaves: i32,
                       last_multiplier: f32, lacunarity: vec3<f32>, persistence: f32,
                       quality: i32) -> f32 {
    var p = position;
    var total = 0.0;
    var amplitude = 1.0;
    var normalization = 0.0;
    for (var i = 0; i < octaves - 1; i += 1) {
        let signal = noise_gradient_three(permutation, gradients, point_wrap, p, quality);
        total += signal * amplitude;
        normalization += amplitude;
        p *= lacunarity;
        amplitude *= persistence;
    }
    normalization += amplitude;
    let signal = noise_gradient_three(permutation, gradients, point_wrap, p, quality);
    total += signal * amplitude * last_multiplier;
    return total / normalization;
}
